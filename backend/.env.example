# Copy to .env and fill in. Never commit .env.
# provider: openai | anthropic | google | ollama.  "openai" also covers any OpenAI-compatible API via LLM_BASE_URL.
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
LLM_BASE_URL=            # e.g. https://api.groq.com/openai/v1 for Groq; empty for OpenAI
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
CONTEXT_MAX_CHARS=24000

CHUNK_SIZE_TOKENS=250
CHUNK_OVERLAP_TOKENS=60
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=documents
TOP_K_RESULTS=8
RETRIEVAL_CANDIDATES=30
MIN_SIMILARITY=0.15
RERANK_ENABLED=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
HYBRID_SEARCH_ENABLED=true

MAX_FILE_SIZE_MB=30
MAX_PDF_PAGES=500
API_KEY=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
JWT_SECRET=
